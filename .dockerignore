# Allow only the inputs required by the full-source Dockerfile.
**
!Dockerfile
!.dockerignore
!requirements.txt
!LICENSE
!app/
!app/**

# Never ship runtime data, credentials, backups, or caches from app/.
**/__pycache__/**
**/*.py[cod]
**/.env
**/.env.*
**/secrets/**
**/credentials/**
**/*.pem
**/*.key
**/data/**
**/inbox/**
**/archive/**
**/failed/**
**/photos/**
**/uploads/**
**/captures/**
**/screenshots/**
**/backups/**
**/backup/**
**/logs/**
**/artifacts/**
**/*.db
**/*.db-*
**/*.sqlite*
**/*.[tT][cC][xX]
**/*.[gG][pP][xX]
**/*.fit
**/*.log
**/*.bak
**/*.backup
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
